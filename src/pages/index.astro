---
import HeadCommon from '../components/HeadCommon.astro';
import HeadSEO from '../components/HeadSEO.astro';
import Card from '../components/Card.astro';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer.astro'
import { SITE } from '@/config';
import {sortPosts} from '@/util'
import series from '@/data/yes-to-being.json';

const posts = await Astro.glob('./posts/*.md');
const allPosts = sortPosts(posts);

---

<html lang="zh-CN">
  <head>
    <HeadCommon />
    <HeadSEO pageURL={SITE.blogPage} content={{}} />
    <title>{SITE.title}</title>
  </head>

  <body>
    <Header />
    <a class="series-feature" href="/series/yes-to-being/" style={`background-image:url(${series.cover})`}>
      <span class="series-feature__shade"></span>
      <span class="series-feature__content">
        <small>持续写作专题</small>
        <strong>{series.title}</strong>
        <span>{series.subtitle}</span>
      </span>
    </a>
    <div
      class="mx-auto -mt-5 mb-12 xl:max-w-7xl w-full lg:max-w-5xl md:max-w-2xl max-w-xl md:box-border box-content md:px-0 px-3"
    >
      <div
        class="grid xl:grid-cols-4 lg:grid-cols-3 md:grid-cols-2 mx-0 md:-mr-5 mr-0"
      >
        {allPosts.map((p) => <Card post={p} />)}
      </div>
    </div>
    <Footer/>
  </body>
</html>

<style>
  .series-feature {
    position: relative;
    min-height: 22rem;
    width: 100%;
    display: flex;
    align-items: flex-end;
    margin-bottom: 3rem;
    background-size: cover;
    background-position: center;
    color: white;
    overflow: hidden;
  }
  .series-feature__shade {
    position: absolute;
    inset: 0;
    background: rgba(18, 31, 27, 0.54);
  }
  .series-feature__content {
    position: relative;
    width: min(74rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3rem 0;
    display: flex;
    flex-direction: column;
    gap: .35rem;
    transition: transform 180ms ease;
  }
  .series-feature small { font-size: .9rem; }
  .series-feature strong {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 4rem;
    line-height: 1.1;
  }
  .series-feature:hover .series-feature__content { transform: translateY(-4px); }
  @media (max-width: 50em) {
    .series-feature { min-height: 19rem; }
    .series-feature strong { font-size: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-feature__content { transition: none; }
  }
</style>
