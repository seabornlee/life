---
import HeadCommon from '@/components/HeadCommon.astro';
import HeadSEO from '@/components/HeadSEO.astro';
import Header from '@/components/Header/Header.astro';
import Footer from '@/components/Footer.astro';
import series from '@/data/yes-to-being.json';
import scriptures from '@/data/scriptures.json';
import '@/styles/heti.min.css';
import '@/styles/series.css';

const frontmatter = Astro.props.frontmatter;
const currentPath = new URL(Astro.request.url).pathname;
const canonicalUrl = `https://life.waterlee.site${currentPath}`;
const content = {
  title: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.cover,
  date: frontmatter.date,
  updated: frontmatter.updated,
};
const chapters = (await Astro.glob('../pages/series/yes-to-being/*.md')).sort(
  (a, b) => a.frontmatter.order - b.frontmatter.order,
);
const currentIndex = chapters.findIndex((chapter) => chapter.frontmatter.id === frontmatter.id);
const previous = currentIndex > 0 ? chapters[currentIndex - 1] : null;
const next = currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;
const scriptureByReference = new Map(
  scriptures.entries.map((entry) => [entry.reference, entry]),
);
const chapterScriptures = frontmatter.sources
  .map((reference) => scriptureByReference.get(reference))
  .filter(Boolean);
---

<html lang="zh-CN">
  <head>
    <HeadCommon />
    <HeadSEO content={content} pageURL={canonicalUrl} noindex={frontmatter.publication_status !== 'published'} />
    <title>{frontmatter.title} | {series.title}</title>
  </head>
  <body class="series-shell">
    <Header />
    <main class="chapter-page">
      <nav class="chapter-breadcrumb" aria-label="面包屑">
        <a href="/">文章</a><span>/</span><a href="/series/yes-to-being/">{series.title}</a>
      </nav>
      <article class="chapter-article heti">
        <header class="chapter-header">
          <p class="series-kicker">第 {String(frontmatter.order).padStart(2, '0')} 章</p>
          <h1>{frontmatter.title}</h1>
          <p class="chapter-deck">{frontmatter.description}</p>
          <div class="chapter-meta">
            <time datetime={frontmatter.updated}>修订于 {frontmatter.updated}</time>
            {frontmatter.publication_status !== 'published' ? <span>本地审阅稿</span> : null}
          </div>
        </header>
        <div class="chapter-domains" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="chapter-body"><slot /></div>
        <footer class="chapter-sources">
          <h2>经文索引</h2>
          <ul>
            {frontmatter.sources.map((source) => (
              <li>
                {scriptureByReference.has(source) ? (
                  <button
                    type="button"
                    class="scripture-trigger"
                    data-scripture-reference={source}
                    aria-haspopup="dialog"
                    aria-controls="scripture-dialog"
                  >
                    <span>{source}</span><span aria-hidden="true">↗</span>
                  </button>
                ) : <span>{source}</span>}
              </li>
            ))}
          </ul>
          <p>这是一份持续修订的学习札记，不代表任何教会或宗派的正式立场。</p>
        </footer>
      </article>
      <nav class="chapter-pagination" aria-label="章节导航">
        {previous ? <a href={previous.url}><small>上一章</small><span>{previous.frontmatter.title}</span></a> : <span></span>}
        {next ? <a href={next.url}><small>下一章</small><span>{next.frontmatter.title}</span></a> : <span></span>}
      </nav>
    </main>
    <dialog id="scripture-dialog" class="scripture-dialog" aria-labelledby="scripture-dialog-title">
      <div class="scripture-dialog__page">
        <header>
          <div>
            <p class="series-kicker">经文原文</p>
            <h2 id="scripture-dialog-title">经文索引</h2>
            <p>{scriptures.translation.name}</p>
          </div>
          <button type="button" class="scripture-dialog__close" aria-label="关闭经文浮窗" title="关闭">×</button>
        </header>
        <div class="scripture-dialog__body">
          {chapterScriptures.map((entry) => (
            <section data-scripture-panel={entry.reference} hidden>
              <div class="scripture-verses">
                {entry.verses.map((verse) => (
                  <p><sup>{verse.number}</sup>{verse.text}</p>
                ))}
              </div>
              <a href={entry.sourceUrl} target="_blank" rel="noreferrer">
                数据来源：{scriptures.translation.sourceName}
              </a>
            </section>
          ))}
        </div>
      </div>
    </dialog>
    <Footer />
    <script>
      const dialog = document.querySelector('#scripture-dialog');
      const title = document.querySelector('#scripture-dialog-title');
      const panels = [...document.querySelectorAll('[data-scripture-panel]')];
      let activeTrigger;

      function closeDialog() {
        if (dialog?.open) dialog.close();
      }

      document.querySelectorAll('[data-scripture-reference]').forEach((button) => {
        button.addEventListener('click', () => {
          const reference = button.dataset.scriptureReference;
          const panel = panels.find(
            (candidate) => candidate.dataset.scripturePanel === reference,
          );
          if (!dialog || !title || !panel) return;

          panels.forEach((candidate) => { candidate.hidden = true; });
          panel.hidden = false;
          title.textContent = reference;
          activeTrigger = button;
          dialog.showModal();
        });
      });

      dialog?.querySelector('.scripture-dialog__close')?.addEventListener('click', closeDialog);
      dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeDialog();
        }
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog?.addEventListener('close', () => activeTrigger?.focus());
    </script>
  </body>
</html>
